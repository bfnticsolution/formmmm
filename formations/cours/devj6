        let currentSlide = 0;
        const totalSlides = slidesData.length;

        function renderSlide(index) {
            const stage = document.getElementById('slideStage');
            const slide = slidesData[index];
            stage.innerHTML = `<div class="slide-content ${slide.className}">${slide.content}</div>`;
            updateProgress(index);
            updateCounter(index);
        }

        function updateProgress(index) {
            const progress = ((index + 1) / totalSlides) * 100;
            document.getElementById('progressBar').style.width = progress + '%';
        }

        function updateCounter(index) {
            document.getElementById('slideCounter').textContent = (index + 1) + ' / ' + totalSlides;
        }

        function goNext() {
            if (currentSlide < totalSlides - 1) {
                currentSlide++;
                renderSlide(currentSlide);
            }
        }

        function goPrev() {
            if (currentSlide > 0) {
                currentSlide--;
                renderSlide(currentSlide);
            }
        }

        renderSlide(currentSlide);

        document.addEventListener('keydown', function(e) {
            switch (e.key) {
                case 'ArrowRight': case ' ': case 'PageDown': case 'ArrowDown':
                    e.preventDefault(); goNext(); break;
                case 'ArrowLeft': case 'PageUp': case 'ArrowUp':
                    e.preventDefault(); goPrev(); break;
                case 'Escape':
                    if (confirm('Quitter la projection ?')) {
                        document.querySelector('.presentation-container').style.display = 'none';
                    }
                    break;
                case 'Home':
                    e.preventDefault(); currentSlide = 0; renderSlide(currentSlide); break;
                case 'End':
                    e.preventDefault(); currentSlide = totalSlides - 1; renderSlide(currentSlide); break;
            }
        });

        let touchStartX = 0;
        document.addEventListener('touchstart', function(e) {
            touchStartX = e.changedTouches[0].screenX;
        });
        document.addEventListener('touchend', function(e) {
            const deltaX = e.changedTouches[0].screenX - touchStartX;
            if (Math.abs(deltaX) > 50) {
                if (deltaX < 0) goNext();
                else goPrev();
            }
        });

        let scrollTimeout = false;
        document.addEventListener('wheel', function(e) {
            if (scrollTimeout) return;
            if (Math.abs(e.deltaY) > 40) {
                scrollTimeout = true;
                if (e.deltaY > 0) goNext();
                else goPrev();
                setTimeout(() => { scrollTimeout = false; }, 600);
            }
        }, { passive: true });
    </script>

